# Directory that holds model subfolders (relative or absolute).
MODEL_DIR=./models
# Name of the model subfolder inside MODEL_DIR.
MODEL_NAME=nllb-200-distilled-600M
# Compute device for CTranslate2: cpu, cuda, or auto.
DEVICE=cpu
# TCP port the HTTP service listens on.
PORT=10015
# Decoding beam size. Higher = better quality, slower (1 = greedy/fastest).
BEAM_SIZE=4
# Maximum input token length per request.
MAX_INPUT_LENGTH=512
# Bearer token clients must present in the Authorization header. REQUIRED. Set to a strong random value.
API_KEY=change-me-to-a-strong-secret
